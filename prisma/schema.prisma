// AstroLogAI Database Schema
// Prisma Schema for PostgreSQL (Supabase)
// 
// US-01: User Registration
// - User model with email, passwordHash, tier, language
// - Profile model with fullName, birthData
// - Preferences model

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER & AUTH
// ============================================

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String    @map("password_hash")
  fullName          String?   @map("full_name")
  tier              Tier      @default(FREE)
  language          String    @default("bg")
  emailVerified            Boolean   @default(false) @map("email_verified")
  verificationToken        String?   @map("verification_token")
  verificationTokenExpiry  DateTime? @map("verification_token_expiry")
  
  // Custom usage tracking for limits
  monthlyQueryCount Int       @default(0) @map("monthly_query_count")
  dailyQueryCount   Int       @default(0) @map("daily_query_count")
  lastQueryDate     DateTime? @map("last_query_date")
  bonusQueries      Int       @default(0) @map("bonus_queries")
  isSuspended       Boolean   @default(false) @map("is_suspended")
  referredBySlug    String?   @map("referred_by_slug")

  // US-28: Email change verification
  pendingEmail      String?   @unique @map("pending_email")       // New email awaiting verification
  pendingEmailToken String?   @map("pending_email_token")        // Verification token
  
  // US-04: OAuth fields
  oauthProvider     String?   @map("oauth_provider") // 'google', 'apple', etc.
  oauthId           String?   @map("oauth_id")       // Supabase auth user ID
  avatarUrl         String?   @map("avatar_url")
  
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Relations
  profile           Profile?
  birthProfiles     BirthProfile[] // US-05: Multi-profile support
  birthChart        BirthChart?
  chatSessions      ChatSession[] // US-07: Chat sessions
  messages          Message[]
  partners          Partner[]
  subscription      Subscription?
  usageRecords      UsageRecord[]
  notificationPreference NotificationPreference? // US-29: Notification Preferences
  dailyForecasts    DailyForecast[]
  refreshTokens     RefreshToken[]
  streak            UserStreak?
  userCredits       UserCredits?
  creditTransactions CreditTransaction[]

  @@map("users")
}

model Profile {
  id                String    @id @default(uuid())
  userId            String    @unique @map("user_id")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  onboardingComplete Boolean   @default(false) @map("onboarding_complete")
  notificationPrefs  Json?     @map("notification_prefs")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("profiles")
}

// US-05: Birth Profile (multi-profile support)
// Users can have multiple birth profiles for family members
model BirthProfile {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String    // Profile name, e.g., "My Chart", "Partner's Chart"
  birthDate         DateTime  @map("birth_date")
  birthTime         String?   @map("birth_time") // "HH:MM" format, null if unknown
  locationName      String    @map("location_name") // City, Country
  latitude          Float
  longitude         Float
  timezone          String
  isUnknownTime     Boolean   @default(false) @map("is_unknown_time")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  birthChart        BirthChart?

  @@index([userId])
  @@map("birth_profiles")
}

model BirthChart {
  id                String    @id @default(uuid())
  userId            String    @unique @map("user_id")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthProfileId    String?   @unique @map("birth_profile_id") // US-05: Link to BirthProfile
  birthProfile      BirthProfile? @relation(fields: [birthProfileId], references: [id])
  chartData         Json      @map("chart_data") // Full chart calculation result
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  
  // US-30: Chart history for archiving
  historyEntries    ChartHistory[]

  @@map("birth_charts")
}

// US-30: Chart History for archiving old charts when birth data changes
model ChartHistory {
  id                String    @id @default(uuid())
  chartId           String    @map("chart_id")
  chart             BirthChart @relation(fields: [chartId], references: [id], onDelete: Cascade)
  
  // Snapshot of the chart data at time of archival
  chartData         Json      @map("chart_data")
  
  // Birth data snapshot that produced this chart
  birthDate         DateTime  @map("birth_date")
  birthTime         String?   @map("birth_time")
  locationName      String    @map("location_name")
  latitude          Float
  longitude         Float
  timezone          String
  
  // Archival metadata
  reason            String    // "birth_data_update" | "manual_archive" | "system"
  archivedAt        DateTime  @default(now()) @map("archived_at")
  
  // User can add notes to historical charts
  notes             String?

  @@index([chartId])
  @@index([archivedAt])
  @@map("chart_history")
}

// ============================================
// CHAT & MESSAGES
// ============================================

// US-07: Chat Session for conversation management
model ChatSession {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String?   // Auto-generated or user-defined
  summary           String?   // Session summary for context compression (after 20+ messages)
  birthProfileId    String?   @map("birth_profile_id") // Optional: which chart to use
  isPinned          Boolean   @default(false) @map("is_pinned")
  isArchived        Boolean   @default(false) @map("is_archived")
  sharedToken       String?   @unique @map("shared_token") // ENH-12: public share link token
  rating            Int?      // ENH-25: 1-5 star session rating
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  messages          ChatMessage[]

  @@index([userId])
  @@index([sharedToken])
  @@map("chat_sessions")
}

model ChatMessage {
  id                String    @id @default(uuid())
  sessionId         String    @map("session_id")
  session           ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role              MessageRole
  content           String
  metadata          Json?     // { tokensUsed, model, processingTime, chartReferenced }
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([sessionId])
  @@map("chat_messages")
}

// Legacy Message model (keeping for backward compatibility)
model Message {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role              MessageRole
  content           String
  metadata          Json?     // For streaming, tokens, etc.
  createdAt         DateTime  @default(now()) @map("created_at")

  @@map("messages")
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

// ============================================
// RELATIONSHIPS (US-18: Add Partner)
// ============================================

enum RelationshipType {
  ROMANTIC
  FRIEND
  FAMILY
  BUSINESS
  OTHER
}

model Partner {
  id                String          @id @default(uuid())
  userId            String          @map("user_id")
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Partner identification
  name              String
  label             String?         @map("label") // Custom label: "Spouse", "Boyfriend", "Crush", etc.
  relationshipType  RelationshipType @default(ROMANTIC) @map("relationship_type")
  
  // Birth data (stored directly for privacy)
  birthDate         DateTime        @map("birth_date")
  birthTime         String?         @map("birth_time") // "HH:MM" format, null if unknown
  locationName      String          @map("location_name") // City, Country
  latitude          Float
  longitude         Float
  timezone          String
  isUnknownTime     Boolean         @default(false) @map("is_unknown_time")
  
  // Optional calculated chart data (cached)
  chartSummary      Json?           @map("chart_summary") // { sunSign, moonSign, risingSign }
  
  // User notes
  notes             String?         // Personal notes about the partner
  
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@index([userId])
  @@map("partners")
}

// ============================================
// SUBSCRIPTION & BILLING
// ============================================

model Subscription {
  id                String    @id @default(uuid())
  userId            String    @unique @map("user_id")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId  String?   @unique @map("stripe_customer_id")
  stripeSubscriptionId String? @unique @map("stripe_subscription_id")
  tier              Tier
  status            SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime? @map("current_period_start")
  currentPeriodEnd   DateTime? @map("current_period_end")
  cancelAtPeriodEnd Boolean   @default(false) @map("cancel_at_period_end")
  scheduledDowngrade Tier?    @map("scheduled_downgrade")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  TRIALING
}

// ============================================
// USAGE & LIMITS
// ============================================

model UsageRecord {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  month             String    // "2026-02" format
  queryCount        Int       @default(0) @map("query_count")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([userId, month])
  @@map("usage_records")
}

// ============================================
// NOTIFICATION PREFERENCES (US-29)
// ============================================

model NotificationPreference {
  id                String    @id @default(uuid())
  userId            String    @unique @map("user_id")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Notification types (each type can be enabled/disabled)
  dailyHoroscope    Boolean   @default(true) @map("daily_horoscope")
  morningBriefing   Boolean   @default(false) @map("morning_briefing") // PIX-134: FEAT-13
  weeklyForecast    Boolean   @default(true) @map("weekly_forecast")
  newReading        Boolean   @default(true) @map("new_reading")
  partnerUpdates    Boolean   @default(false) @map("partner_updates")
  marketing         Boolean   @default(false)
  
  // Channels (which delivery methods are enabled)
  emailEnabled      Boolean   @default(true) @map("email_enabled")
  pushEnabled       Boolean   @default(false) @map("push_enabled")
  smsEnabled        Boolean   @default(false) @map("sms_enabled")
  
  // Phone number for SMS (optional)
  phoneNumber       String?   @map("phone_number")
  
  // Unsubscribe token for email links
  unsubscribeToken  String?   @unique @map("unsubscribe_token")
  
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("notification_preferences")
}

// ============================================
// ENUMS
// ============================================

enum Tier {
  FREE
  PRO
  PREMIUM
}

// ============================================
// ADMIN — LLM USAGE TRACKING
// ============================================

// Daily aggregate of LLM token usage per tier + model.
// Written by the LLM service after each streaming completion.
model LlmUsage {
  id            String   @id @default(uuid())
  date          DateTime @db.Date                // day bucket (no time component)
  tier          Tier
  model         String                           // "claude-haiku-4-5-20251001", etc.
  requestCount  Int      @default(0) @map("request_count")
  inputTokens   BigInt   @default(0) @map("input_tokens")
  outputTokens  BigInt   @default(0) @map("output_tokens")
  totalTokens   BigInt   @default(0) @map("total_tokens")
  costUsdCents  Int      @default(0) @map("cost_usd_cents")  // avoid float, store as integer cents
  p50LatencyMs  Int      @default(0) @map("p50_latency_ms")
  p95LatencyMs  Int      @default(0) @map("p95_latency_ms")
  p99LatencyMs  Int      @default(0) @map("p99_latency_ms")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([date, tier, model])
  @@index([date])
  @@index([tier])
  @@map("llm_usage")
}

// ============================================
// ADMIN — EDITABLE SYSTEM PROMPTS
// ============================================

model SystemPrompt {
  id        String   @id @default(uuid())
  name      String   @unique                      // "master", "free_addon", "pro_addon", "premium_addon", "forecast", "compatibility"
  label     String                                // Display: "Master Prompt", "Free Tier Addon", etc.
  content   String   @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")
  history   SystemPromptHistory[]

  @@map("system_prompts")
}

model SystemPromptHistory {
  id        String       @id @default(uuid())
  promptId  String       @map("prompt_id")
  prompt    SystemPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  content   String       @db.Text
  version   Int
  savedAt   DateTime     @default(now()) @map("saved_at")
  savedBy   String       @map("saved_by")         // admin email

  @@index([promptId])
  @@map("system_prompt_history")
}

// ============================================
// ADMIN — RUNTIME CONFIGURATION
// ============================================

// Key/value config store for runtime overrides (model strings per tier, etc.)
model AdminConfig {
  id        String   @id @default(uuid())
  key       String   @unique                      // "model_free", "model_pro", "model_premium"
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String   @map("updated_by")           // admin email

  @@map("admin_config")
}

// ============================================
// ADMIN — DISCOUNT CODES
// ============================================

model DiscountCode {
  id                   String    @id @default(uuid())
  code                 String    @unique
  stripePromotionCodeId String?  @map("stripe_promotion_code_id")
  discountType         String    @default("percent") @map("discount_type")  // "percent" | "amount"
  discountValue        Int       @map("discount_value")                     // % or EUR cents
  appliesTo            String    @default("ALL") @map("applies_to")         // "PRO" | "PREMIUM" | "ALL"
  maxUses              Int?      @map("max_uses")                           // null = unlimited
  usesCount            Int       @default(0) @map("uses_count")
  expiresAt            DateTime? @map("expires_at")
  isActive             Boolean   @default(true) @map("is_active")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("discount_codes")
}

// ============================================
// ADMIN — REFERRAL LINKS
// ============================================

model ReferralLink {
  id             String    @id @default(uuid())
  slug           String    @unique
  label          String                            // "John's Blog", "Instagram Bio"
  commissionRate Float     @default(0.2) @map("commission_rate")  // 0.20 = 20%
  clicks         Int       @default(0)
  isActive       Boolean   @default(true) @map("is_active")
  discountCode   String?   @map("discount_code")
  createdAt      DateTime  @default(now()) @map("created_at")
  conversions    ReferralConversion[]

  @@map("referral_links")
}

model ReferralConversion {
  id              String       @id @default(uuid())
  linkId          String       @map("link_id")
  link            ReferralLink @relation(fields: [linkId], references: [id])
  userId          String       @map("user_id")
  tier            Tier
  revenueEurCents Int          @default(0) @map("revenue_eur_cents")
  commissionCents Int          @default(0) @map("commission_cents")
  convertedAt     DateTime     @default(now()) @map("converted_at")

  @@index([linkId])
  @@map("referral_conversions")
}

// ============================================
// PRE-GENERATED DAILY FORECASTS
// ============================================

// Stores LLM-generated forecasts per user per date.
// Written by the nightly cron job at 2am.
// API endpoints read from here — zero LLM calls on page load.
model DailyForecast {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        String   // "2026-03-14" — one row per user per day
  horoscope   Json?    // getPersonalDailyHoroscope() result
  forecast    Json?    // generateDailyForecast() result
  generatedAt DateTime @default(now()) @map("generated_at")

  @@unique([userId, date])
  @@index([date])
  @@map("daily_forecasts")
}

// ============================================
// REFRESH TOKEN ROTATION (BUG-38)
// ============================================

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  familyId   String    @map("family_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  usedAt     DateTime? @map("used_at")
  revokedAt  DateTime? @map("revoked_at")
  expiresAt  DateTime  @map("expires_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "refresh_tokens_user_id_idx")
  @@index([familyId], name: "refresh_tokens_family_id_idx")
  @@map("refresh_tokens")
}

// ============================================
// USER STREAKS (ENH-23)
// ============================================

model UserStreak {
  id               String    @id @default(uuid())
  userId           String    @unique @map("user_id")
  currentStreak    Int       @default(0) @map("current_streak")
  longestStreak    Int       @default(0) @map("longest_streak")
  lastActivityDate DateTime? @map("last_activity_date") // date of last Oracle message (date only)
  trialTier        String?   @map("trial_tier")         // e.g. 'PRO' if a trial is active
  trialExpiresAt   DateTime? @map("trial_expires_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_streaks")
}

// ============================================
// CREDITS — FEAT-10: One-time purchases
// ============================================

model UserCredits {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance        Int      @default(0)          // current balance (CHECK >= 0 in migration SQL)
  totalPurchased Int      @default(0) @map("total_purchased")
  totalSpent     Int      @default(0) @map("total_spent")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("user_credits")
}

model CreditTransaction {
  id                    String   @id @default(uuid())
  userId                String   @map("user_id")
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                  String   // 'purchase' | 'spend' | 'refund' | 'bonus'
  amount                Int      // positive for credit, negative for debit
  balanceAfter          Int      @map("balance_after")
  description           String
  stripePaymentIntentId String?  @unique @map("stripe_payment_intent_id") // idempotency for webhooks
  purchaseAmountCents   Int?     @map("purchase_amount_cents") // EUR cents paid (for upsell threshold)
  relatedEntityType     String?  @map("related_entity_type") // 'oracle_session' | 'tool_call' etc.
  relatedEntityId       String?  @map("related_entity_id")
  createdAt             DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("credit_transactions")
}
