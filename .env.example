# AstroLogAI Environment Variables

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/astrologaai?schema=public"

# Supabase (for production)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Auth
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Redis
REDIS_URL="redis://localhost:6379"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_PRO="price_..."
STRIPE_PRICE_PREMIUM="price_..."

# AI Providers
GLM_API_KEY="your-glm-api-key"
MINIMAX_API_KEY="your-minimax-api-key"

# Astrology API
ASTROLOGY_API_KEY="your-astrology-api-key"
ASTROLOGY_API_URL="https://json.astrology-api.io/v1"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# App
NODE_ENV="development"
PORT=4000
